# Google Gemini API Key for Server-Side AI Chat & Patient Health Assistant
GEMINI_API_KEY=

# Google Maps Platform API Key (Public Client Key for Interactive Maps & Geocoding)
VITE_GOOGLE_MAPS_API_KEY=

# Razorpay Master Account Keys for Multi-Doctor Route Marketplace Split Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Dispatch Gateway for Real Gmail Inbox OTP Delivery (Optional)
# If provided, system sends real emails to recipient's Gmail inbox.
# If empty, OTP is clearly displayed on screen with instant 1-click test autofill.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or custom SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

